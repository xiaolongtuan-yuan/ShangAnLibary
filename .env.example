# ============ 上岸书房 · 环境配置 ============
# 复制为 .env 并修改后执行 ./deploy.sh 或 docker compose up -d --build

# 数据库（首次部署可保持默认，改强密码更安全）
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=请改成强密码

# JWT 与签名密钥（必填，>=32 位随机字符串，可用 openssl rand -hex 32 生成）
SECRET_KEY=请改成随机长字符串

# 初始管理员账号（容器首次启动自动创建）
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=请改成强密码
INIT_ADMIN_EMAIL=admin@example.com
